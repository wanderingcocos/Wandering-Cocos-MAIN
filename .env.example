# ─── Server ───────────────────────────────────────────────────────────────────

# Port the Node.js server listens on.
# Hostinger sets this automatically — do not override it in hPanel env vars.
PORT=3000

# Node environment. Must be "production" on Hostinger.
NODE_ENV=production

# ─── Database ─────────────────────────────────────────────────────────────────

# Full PostgreSQL connection string from your Neon console.
# Format: postgresql://<user>:<password>@<host>/<dbname>?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── Frontend build (build time only — not needed at runtime) ─────────────────

# Base path the frontend is served from. Use "/" for a root domain on Hostinger.
# This is only needed when running "npm run build:prod" — not at server start.
BASE_PATH=/
